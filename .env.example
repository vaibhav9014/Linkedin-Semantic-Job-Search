# Copy to backend/.env. These are placeholders; never commit real credentials.
JSEARCH_BASE_URL=https://jsearch.p.rapidapi.com/search-v2
JSEARCH_AUTH_HEADER=x-rapidapi-key
JSEARCH_API_KEY=your_rapidapi_key
JSEARCH_COUNTRY=us
JSEARCH_DATE_POSTED=all
JSEARCH_DEFAULT_LOCATION=India

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Generate a unique random value for APP_SECRET_KEY before running the backend.
APP_SECRET_KEY=replace_with_a_long_random_secret

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Set to true and "none" when frontend and backend are on separate HTTPS origins.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LINKEDIN_API_VERSION=202610
